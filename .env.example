# X API v2 (Official — requires developer account)
X_BEARER_TOKEN=

# GraphQL fallback (cookie-based). Aliases: TWITTER_AUTH_TOKEN, TWITTER_CT0
AUTH_TOKEN=
CT0=

# API-backed AI providers (optional). These are explicit paid modes and are
# never used automatically when a subscription CLI is unavailable.
# Grok API alias: GROK_API_KEY. Gemini alias: GEMINI_API_KEY.
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# Comma-separated operator opt-outs, for example when Claude Code is installed
# but the signed-in account has no active Pro/Max entitlement.
# POLYX_DISABLED_SUBSCRIPTION_PROVIDERS=claude-subscription

# Budget & Cache
POLYX_DAILY_BUDGET=1.00
POLYX_CACHE_TTL=900
# POLYX_CACHE_DIR=/path/to/private/cache
# POLYX_DATA_DIR=/path/to/private/data
